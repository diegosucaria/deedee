{
    "homeassistant": {
        "transport": "stdio",
        "command": "ha-mcp",
        "args": [],
        "env": {
            "HA_URL": "${HA_URL}",
            "HA_TOKEN": "${HA_TOKEN}"
        },
        "disabled": false
    },
    "plex": {
        "command": "python3",
        "args": [
            "plex_mcp_server.py",
            "--transport",
            "stdio"
        ],
        "cwd": "../../packages/plex-mcp-server",
        "env": {
            "PLEX_URL": "${PLEX_URL}",
            "PLEX_TOKEN": "${PLEX_TOKEN}"
        },
        "disabled": false
    },
    "node-red": {
        "command": "node",
        "args": [
            "index.js"
        ],
        "cwd": "../../packages/node-red-mcp",
        "env": {
            "NODE_RED_URL": "${NODE_RED_URL}",
            "NODE_RED_USERNAME": "${NODE_RED_USERNAME}",
            "NODE_RED_PASSWORD": "${NODE_RED_PASSWORD}"
        },
        "disabled": false
    }
}