{
    "homeassistant": {
        "transport": "stdio",
        "command": "ha-mcp",
        "args": [],
        "env": {
            "HA_URL": "${HA_URL}",
            "HA_TOKEN": "${HA_TOKEN}"
        },
        "disabled": false
    },
    "plex": {
        "command": "python3",
        "args": [
            "plex_mcp_server.py",
            "--transport",
            "stdio"
        ],
        "cwd": "../../packages/plex-mcp-server",
        "env": {
            "PLEX_URL": "${PLEX_URL}",
            "PLEX_TOKEN": "${PLEX_TOKEN}"
        },
        "disabled": false
    },
    "node-red": {
        "command": "node",
        "args": [
            "index.js"
        ],
        "cwd": "../../packages/node-red-mcp",
        "env": {
            "NODE_RED_URL": "${NODE_RED_URL}",
            "NODE_RED_USERNAME": "${NODE_RED_USERNAME}",
            "NODE_RED_PASSWORD": "${NODE_RED_PASSWORD}"
        },
        "disabled": false
    },
    "browser": {
        "command": "node",
        "args": [
            "index.js"
        ],
        "cwd": "../../packages/mcp-servers/browser",
        "env": {
            "BROWSER_HEADLESS": "${BROWSER_HEADLESS}"
        },
        "disabled": true
    },
    "browser-use": {
        "command": "python3",
        "args": [
            "server.py",
            "--transport",
            "stdio"
        ],
        "cwd": "../../packages/mcp-servers/browser-use",
        "env": {
            "GOOGLE_API_KEY": "${GOOGLE_API_KEY}",
            "BROWSER_USE_MODEL": "${BROWSER_USE_MODEL}",
            "BROWSER_USE_HEADLESS": "${BROWSER_USE_HEADLESS}",
            "BROWSER_EXECUTABLE_PATH": "${BROWSER_EXECUTABLE_PATH}",
            "INTERFACES_URL": "${INTERFACES_URL}",
            "DEEDEE_API_TOKEN": "${DEEDEE_API_TOKEN}"
        },
        "disabled": false
    }
}