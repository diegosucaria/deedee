{
    "homeassistant": {
        "transport": "stdio",
        "command": "ha-mcp",
        "args": [],
        "includeTools": [
            "ha_search",
            "ha_get_overview",
            "ha_get_state",
            "ha_get_entity",
            "ha_get_device",
            "ha_get_history",
            "ha_call_service",
            "ha_bulk_control",
            "ha_list_services",
            "ha_list_floors_areas",
            "ha_get_camera_image",
            "ha_eval_template",
            "ha_get_operation_status",
            "ha_get_zone",
            "ha_get_todo",
            "ha_set_todo_item",
            "ha_remove_todo_item",
            "ha_config_get_calendar_events",
            "ha_config_set_calendar_event",
            "ha_config_get_automation",
            "ha_config_get_script",
            "ha_config_get_scene"
        ],
        "env": {
            "HA_URL": "${HA_URL}",
            "HA_TOKEN": "${HA_TOKEN}"
        },
        "disabled": false
    },
    "plex": {
        "command": "python3",
        "args": [
            "plex_mcp_server.py",
            "--transport",
            "stdio"
        ],
        "cwd": "../../packages/plex-mcp-server",
        "env": {
            "PLEX_URL": "${PLEX_URL}",
            "PLEX_TOKEN": "${PLEX_TOKEN}"
        },
        "disabled": false
    },
    "node-red": {
        "command": "node",
        "args": [
            "index.js"
        ],
        "cwd": "../../packages/node-red-mcp",
        "env": {
            "NODE_RED_URL": "${NODE_RED_URL}",
            "NODE_RED_USERNAME": "${NODE_RED_USERNAME}",
            "NODE_RED_PASSWORD": "${NODE_RED_PASSWORD}"
        },
        "disabled": false
    },
    "browser": {
        "command": "node",
        "args": [
            "index.js"
        ],
        "cwd": "../../packages/mcp-servers/browser",
        "env": {
            "BROWSER_HEADLESS": "${BROWSER_HEADLESS}"
        },
        "disabled": true
    },
    "browser-use": {
        "command": "python3",
        "args": [
            "server.py",
            "--transport",
            "stdio"
        ],
        "cwd": "../../packages/mcp-servers/browser-use",
        "env": {
            "GOOGLE_API_KEY": "${GOOGLE_API_KEY}",
            "WORKER_FLASH": "${WORKER_FLASH}",
            "BROWSER_USE_HEADLESS": "${BROWSER_USE_HEADLESS}",
            "BROWSER_EXECUTABLE_PATH": "${BROWSER_EXECUTABLE_PATH}",
            "INTERFACES_URL": "${INTERFACES_URL}",
            "DEEDEE_API_TOKEN": "${DEEDEE_API_TOKEN}"
        },
        "disabled": false
    },
    "pilotfy": {
        "command": "python3",
        "args": [
            "server.py",
            "--transport",
            "stdio"
        ],
        "cwd": "../../packages/mcp-servers/pilotfy",
        "env": {
            "PILOTFY_EMAIL": "${PILOTFY_EMAIL}",
            "PILOTFY_PASSWORD": "${PILOTFY_PASSWORD}",
            "PILOTFY_TOKEN": "${PILOTFY_TOKEN}"
        },
        "disabled": false
    },
    "allende": {
        "command": "python3",
        "args": [
            "server.py",
            "--transport",
            "stdio"
        ],
        "cwd": "../../packages/mcp-servers/allende",
        "env": {
            "ALLENDE_USERNAME": "${ALLENDE_USERNAME}",
            "ALLENDE_PASSWORD": "${ALLENDE_PASSWORD}",
            "ALLENDE_TOKEN": "${ALLENDE_TOKEN}"
        },
        "disabled": false
    }
}
