# Google Gemini API
# Get clean key: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# Telegram Bot
# Get from BotFather
TELEGRAM_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
ALLOWED_TELEGRAM_IDS=123456789,987654321

# Access Control
# Token for external API calls (e.g. iOS Shortcuts) to apps/api
DEEDEE_API_TOKEN=generate_a_secure_random_string_here

# GitHub (for self-improvement)
# Repo Access Token
GITHUB_PAT=ghp_your_personal_access_token_here

# Optional Integrations
PLEX_URL=http://192.168.1.10:32400
PLEX_TOKEN=your_plex_token_here
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/XXXX
DISCOGS_TOKEN=your_discogs_personal_access_token
 

# Backups (Service Account - Optional)
# Required ONLY if using GCS Backups. Not needed for Calendar.
GOOGLE_APPLICATION_CREDENTIALS=/app/data/service-account.json
GCS_BACKUP_BUCKET=deedee-backups

# Agent Configuration (Defaults usually fine)
MAX_TOOL_LOOPS=50
# Model roles (all optional; defaults in apps/agent/src/services/config-service.js, see docs/models.md)
ROUTER_MODEL=gemini-3.1-flash-lite
WORKER_LITE=gemini-3.1-flash-lite
WORKER_FLASH=gemini-3.6-flash # Must support Google Search Grounding if USE_NATIVE_SEARCH=true
USE_NATIVE_SEARCH=true
WORKER_PRO=gemini-3.1-pro-preview
WORKER_GOOGLE_SEARCH=gemini-3.6-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=1536
WORKER_LIVE=gemini-3.8-live
